diff --git a/test/bootptest.c b/test/bootptest.c
new file mode 100644
index 00000000..713e6fc3
--- /dev/null
+++ b/test/bootptest.c
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Copyright (c) 2026 Bryce Lanham
+ */
+
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "libslirp.h"
+
+#define ETHERNET_HEADER_LEN 14
+#define IPV4_HEADER_LEN 20
+#define UDP_HEADER_LEN 8
+#define BOOTP_FIXED_LEN 236
+#define BOOTP_VENDOR_LEN 64
+#define DHCP_OPTION_CAPACITY 312
+
+#define BOOTP_OFFSET (ETHERNET_HEADER_LEN + IPV4_HEADER_LEN + UDP_HEADER_LEN)
+#define BOOTP_XID_OFFSET 4
+#define BOOTP_YIADDR_OFFSET 16
+#define BOOTP_SIADDR_OFFSET 20
+#define BOOTP_HWADDR_OFFSET 28
+#define BOOTP_FILE_OFFSET 108
+#define BOOTP_VENDOR_OFFSET 236
+
+#define REQUEST_LENGTH \
+    (BOOTP_OFFSET + BOOTP_FIXED_LEN + BOOTP_VENDOR_LEN)
+#define DHCP_RESPONSE_LENGTH \
+    (BOOTP_OFFSET + BOOTP_FIXED_LEN + DHCP_OPTION_CAPACITY)
+#define CAPTURE_CAPACITY 1024
+
+typedef enum RequestKind {
+    REQUEST_NEXT_V1,
+    REQUEST_NEXT_V2,
+    REQUEST_RFC1533,
+} RequestKind;
+
+typedef struct Capture {
+    uint8_t packet[CAPTURE_CAPACITY];
+    size_t length;
+    unsigned int count;
+} Capture;
+
+static const uint8_t client_mac[] = { 0x00, 0x00, 0x0f, 0x12, 0x34, 0x56 };
+static const uint8_t xid[] = { 0x12, 0x34, 0x56, 0x78 };
+
+static void store_be16(uint8_t *p, uint16_t value)
+{
+    p[0] = value >> 8;
+    p[1] = value;
+}
+
+static uint16_t ipv4_checksum(const uint8_t *header, size_t length)
+{
+    uint32_t sum = 0;
+    size_t i;
+
+    assert((length & 1) == 0);
+    for (i = 0; i < length; i += 2) {
+        sum += ((uint16_t)header[i] << 8) | header[i + 1];
+    }
+    while (sum >> 16) {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    return (uint16_t)~sum;
+}
+
+static void build_request(uint8_t request[REQUEST_LENGTH], RequestKind kind)
+{
+    uint8_t *ip = request + ETHERNET_HEADER_LEN;
+    uint8_t *udp = ip + IPV4_HEADER_LEN;
+    uint8_t *bootp = request + BOOTP_OFFSET;
+    uint8_t *vendor = bootp + BOOTP_VENDOR_OFFSET;
+
+    memset(request, 0, REQUEST_LENGTH);
+
+    memset(request, 0xff, 6);
+    memcpy(request + 6, client_mac, sizeof(client_mac));
+    store_be16(request + 12, 0x0800);
+
+    ip[0] = 0x45;
+    store_be16(ip + 2, REQUEST_LENGTH - ETHERNET_HEADER_LEN);
+    ip[8] = 64;
+    ip[9] = 17;
+    memset(ip + 16, 0xff, 4);
+    store_be16(ip + 10, 0);
+    store_be16(ip + 10, ipv4_checksum(ip, IPV4_HEADER_LEN));
+
+    store_be16(udp, 68);
+    store_be16(udp + 2, 67);
+    store_be16(udp + 4, REQUEST_LENGTH - ETHERNET_HEADER_LEN -
+               IPV4_HEADER_LEN);
+    store_be16(udp + 6, 0);
+
+    bootp[0] = 1;
+    bootp[1] = 1;
+    bootp[2] = 6;
+    memcpy(bootp + BOOTP_XID_OFFSET, xid, sizeof(xid));
+    memcpy(bootp + BOOTP_HWADDR_OFFSET, client_mac, sizeof(client_mac));
+
+    if (kind == REQUEST_RFC1533) {
+        const uint8_t dhcp_discover[] = {
+            0x63, 0x82, 0x53, 0x63,
+            53, 1, 1,
+            255,
+        };
+
+        memcpy(vendor, dhcp_discover, sizeof(dhcp_discover));
+    } else {
+        const uint8_t next_vendor[] = {
+            'N', 'e', 'X', 'T',
+            kind == REQUEST_NEXT_V1 ? 1 : 2,
+            0,
+            0x5a,
+        };
+
+        memcpy(vendor, next_vendor, sizeof(next_vendor));
+    }
+}
+
+static slirp_ssize_t send_packet(const void *buf, size_t len, void *opaque)
+{
+    Capture *capture = opaque;
+
+    assert(len <= CAPTURE_CAPACITY);
+    memcpy(capture->packet, buf, len);
+    capture->length = len;
+    capture->count++;
+    return len;
+}
+
+static int64_t clock_get_ns(void *opaque)
+{
+    (void)opaque;
+    return 0;
+}
+
+static Capture run_request(RequestKind kind)
+{
+    SlirpConfig config = {
+        .version = 4,
+        .in_enabled = true,
+        .vnetwork.s_addr = htonl(0x0a000200),
+        .vnetmask.s_addr = htonl(0xffffff00),
+        .vhost.s_addr = htonl(0x0a000202),
+        .bootfile = "sdmach",
+        .vdhcp_start.s_addr = htonl(0x0a00020f),
+        .vnameserver.s_addr = htonl(0x0a000203),
+    };
+    SlirpCb callbacks = {
+        .send_packet = send_packet,
+        .clock_get_ns = clock_get_ns,
+    };
+    Capture capture = { 0 };
+    uint8_t request[REQUEST_LENGTH];
+    Slirp *slirp;
+
+    build_request(request, kind);
+    slirp = slirp_new(&config, &callbacks, &capture);
+    assert(slirp != NULL);
+    slirp_input(slirp, request, sizeof(request));
+    slirp_cleanup(slirp);
+
+    return capture;
+}
+
+static void check_common_reply(const Capture *capture)
+{
+    const uint8_t yiaddr[] = { 10, 0, 2, 15 };
+    const uint8_t siaddr[] = { 10, 0, 2, 2 };
+
+    assert(capture->count == 1);
+    assert(capture->packet[12] == 0x08);
+    assert(capture->packet[13] == 0x00);
+    assert(capture->packet[ETHERNET_HEADER_LEN + 9] == 17);
+    assert(capture->packet[BOOTP_OFFSET] == 2);
+    assert(memcmp(capture->packet + BOOTP_OFFSET + BOOTP_XID_OFFSET,
+                  xid, sizeof(xid)) == 0);
+    assert(memcmp(capture->packet + BOOTP_OFFSET + BOOTP_YIADDR_OFFSET,
+                  yiaddr, sizeof(yiaddr)) == 0);
+    assert(memcmp(capture->packet + BOOTP_OFFSET + BOOTP_SIADDR_OFFSET,
+                  siaddr, sizeof(siaddr)) == 0);
+    assert(memcmp(capture->packet + BOOTP_OFFSET + BOOTP_FILE_OFFSET,
+                  "sdmach", strlen("sdmach")) == 0);
+}
+
+static void test_next_v1_reply(void)
+{
+    const uint8_t expected_vendor[BOOTP_VENDOR_LEN] = {
+        'N', 'e', 'X', 'T', 1, 0, 0x5a,
+    };
+    Capture capture = run_request(REQUEST_NEXT_V1);
+
+    check_common_reply(&capture);
+    assert(capture.length == REQUEST_LENGTH);
+    assert(memcmp(capture.packet + BOOTP_OFFSET + BOOTP_VENDOR_OFFSET,
+                  expected_vendor, sizeof(expected_vendor)) == 0);
+}
+
+static void test_next_unknown_version_falls_back(void)
+{
+    const uint8_t dhcp_ack[] = { 99, 130, 83, 99, 53, 1, 5 };
+    Capture capture = run_request(REQUEST_NEXT_V2);
+
+    check_common_reply(&capture);
+    assert(capture.length == DHCP_RESPONSE_LENGTH);
+    assert(memcmp(capture.packet + BOOTP_OFFSET + BOOTP_VENDOR_OFFSET,
+                  dhcp_ack, sizeof(dhcp_ack)) == 0);
+}
+
+static void test_rfc1533_reply_unchanged(void)
+{
+    const uint8_t dhcp_offer[] = {
+        0x63, 0x82, 0x53, 0x63,
+        53, 1, 2,
+    };
+    Capture capture = run_request(REQUEST_RFC1533);
+
+    check_common_reply(&capture);
+    assert(capture.length == DHCP_RESPONSE_LENGTH);
+    assert(memcmp(capture.packet + BOOTP_OFFSET + BOOTP_VENDOR_OFFSET,
+                  dhcp_offer, sizeof(dhcp_offer)) == 0);
+}
+
+int main(void)
+{
+    test_next_unknown_version_falls_back();
+    test_rfc1533_reply_unchanged();
+    test_next_v1_reply();
+    return 0;
+}
